    "chromium": {
      "command": ["node", "-e", "const fs=require('node:fs');let p;try{p=require('playwright')}catch{process.exit(2)}process.exit(fs.existsSync(p.chromium.executablePath())?0:1)"],
      "hint": "Install Playwright and its Chromium build (npx playwright install --with-deps chromium) and expose it via NODE_PATH/PLAYWRIGHT_BROWSERS_PATH."
    },
    "bwrap": { "command": ["bwrap", "--version"], "sandboxOnly": true, "hint": "apt-get install bubblewrap (needed by the Claude Code sandbox on Linux), or set RUNNER_SANDBOX=off on a dedicated VM." },
    "socat": { "command": ["socat", "-V"], "sandboxOnly": true, "hint": "apt-get install socat (needed by the Claude Code sandbox network proxy on Linux)." }
  },
