# Allow-list egress proxy (Squid from Debian's archive). Configuration: squid.conf (mounted read-only, generated by
# Install-CrestmontRunner.ps1 from squid.conf.template). Access log -> stdout -> Docker json-file log (rotated).
# CI builds this image and runs `squid -k parse` on a rendered configuration (.github/workflows/ci.yml, runner-images).
# The base is an exact Debian point-release tag; pin it by digest once CI has printed the digest (RUNNER-SETUP.md 12).
# Debian packages are not version-pinned (bookworm security updates); hadolint DL3008 is ignored for that reason.
#
# Squid runs as Debian's unprivileged `proxy` user from the start (port 3128 needs no root). Started as root, it
# would switch to `proxy` and then fail with "FATAL: Cannot open '/dev/stdout' for writing" because the container's
# stdout pipe belongs to root (reproduced locally with Squid 5.7; see LOCAL-VALIDATION.md "Validation status").
# Running as `proxy` also means the container needs no capabilities at all (compose: cap_drop ALL, no cap_add).
ARG DEBIAN_IMAGE=debian:12.12-slim@sha256:d5d3f9c23164ea16f31852f95bd5959aad1c5e854332fe00f7b3a20fcc9f635c
FROM ${DEBIAN_IMAGE}
# hadolint ignore=DL3008
RUN apt-get update \
 && apt-get install -y --no-install-recommends squid ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /run/squid && chown proxy:proxy /run/squid
USER proxy
WORKDIR /run/squid
EXPOSE 3128
CMD ["squid", "-N", "-d", "1", "-f", "/etc/squid/squid.conf"]
