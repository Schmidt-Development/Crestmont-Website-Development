// Cloudflare Worker with static assets. public/ is served directly; only /api/* runs the Worker first.
// Preview deploys are done by the Crestmont runner with a preview-only account; do not add routes, custom domains
// or a custom "build" command here (the runner refuses to deploy a config that has them).
{
  "name": "customer-site",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Leave empty until a mail provider is connected; the contact endpoint answers "not configured" meanwhile.
    "CONTACT_MAIL_PROVIDER": ""
  }
}
