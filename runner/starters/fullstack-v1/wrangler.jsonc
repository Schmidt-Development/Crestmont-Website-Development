// Cloudflare Worker: static assets in public/ plus the /api/* backend in src/worker.js, with this website's OWN D1
// database. Preview deploys are done by the Crestmont runner; do not add routes, custom domains or a build command.
// Secrets (set on the customer's account with `wrangler secret put`, never here): STRIPE_SECRET_KEY,
// STRIPE_WEBHOOK_SECRET, RESEND_API_KEY, MAIL_FROM, ADMIN_SETUP_TOKEN.
{
  "name": "customer-site",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "customer-site-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "ENVIRONMENT": "staging" }
}
