{
  // Runner typecheck: `npx tsc -p runner/tsconfig.json`.
  // "paths" points the SDK import at the local declaration shim (src/sdk-types.d.ts) because the package
  // cannot be installed in every environment. Once `npm install` has run in runner/, delete the "paths" entry
  // to typecheck against the real @anthropic-ai/claude-agent-sdk declarations.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@anthropic-ai/claude-agent-sdk": ["./src/sdk-types.d.ts"]
    }
  },
  "include": ["src", "test", "windows/*.ts", "ci/*.ts"],
  // The imported-frontend fixtures are React/Vite projects with their own tsconfig, toolchain and dependencies.
  // They are test DATA -- the thing the import pipeline consumes -- not runner code, and each is compiled by Vite
  // inside the sandbox against its own tsconfig, never by this typecheck.
  //
  // Patterns rather than a list of names: a fourth fixture would otherwise break the runner's typecheck the moment
  // it was committed, with an error ("cannot use JSX unless the '--jsx' flag is provided") that says nothing about
  // why a frontend fixture is being compiled as runner code at all.
  "exclude": ["test/fixtures/*-frontend", "test/fixtures/*-integration"]
}
